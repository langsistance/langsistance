{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-test",
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "#utils/*": [
        "src/utils/*"
      ]
    }
  },
  "include": [
    "src/utils/**/*.ts",
    "src/utils/**/*.mjs",
    "src/services/resultsStore.ts",
    "src/services/resultsStore.test.mjs",
    "src/services/taroRuntimeStubs.ts"
  ]
}
