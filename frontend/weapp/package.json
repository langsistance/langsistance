{
  "name": "copiioai-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "CopiioAI 微信小程序（Taro + React + TS，国内微信用户）",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "sass"
  },
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "build:weapp": "taro build --type weapp && npm run check:syntax && npm run check:appid",
    "check:syntax": "node scripts/check-dist-syntax.mjs",
    "check:appid": "node scripts/check-dist-appid.mjs",
    "tsc": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && bash -c \"shopt -s globstar; set -- dist-test/**/*.test.mjs; if [ ! -e \\\"$1\\\" ]; then echo 'No compiled test files matched dist-test/**/*.test.mjs' >&2; exit 1; fi; node --test \\\"$@\\\"\""
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@tarojs/components": "4.1.x",
    "@tarojs/helper": "4.1.x",
    "@tarojs/plugin-framework-react": "4.1.x",
    "@tarojs/plugin-platform-weapp": "4.1.x",
    "@tarojs/react": "4.1.x",
    "@tarojs/runtime": "4.1.x",
    "@tarojs/shared": "4.1.x",
    "@tarojs/taro": "4.1.x",
    "marked": "^18.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@tarojs/cli": "4.1.x",
    "@tarojs/taro-loader": "4.1.x",
    "@tarojs/webpack5-runner": "4.1.x",
    "@types/react": "^18.3.3",
    "@types/webpack-env": "^1.18.4",
    "babel-preset-taro": "4.1.x",
    "postcss": "^8.4.38",
    "sass": "^1.77.0",
    "typescript": "^5.5.0",
    "webpack": "5.91.0"
  }
}
